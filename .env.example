# Copy this file to .env for local development.
# On Render, set these as Environment Variables in the dashboard instead.

PORT=3000

# Long random string used to sign session cookies. Generate a new one for production.
SESSION_SECRET=change_this_to_a_long_random_string

# Initial admin account (only used the first time db/seed.js runs)
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change_this_password

# Company contact details shown on the Contact page
COMPANY_EMAIL=info@yourcompany.com
COMPANY_PHONE=+233 20 000 0000
COMPANY_ADDRESS=Accra, Ghana
