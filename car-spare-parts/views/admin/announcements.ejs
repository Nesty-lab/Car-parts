<%- include('../partials/admin-header', { title: 'Announcements - Admin' }) %>

<h1>Announcements</h1>
<p class="muted">Active announcements are shown in a banner at the top of every customer-facing page.</p>

<% if (errors && errors.length) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form action="/admin/announcements/new" method="POST" class="form">
  <label for="title">Title</label>
  <input type="text" id="title" name="title" required>

  <label for="body">Message</label>
  <textarea id="body" name="body" rows="3" required></textarea>

  <button type="submit" class="btn">Post Announcement</button>
</form>

<h2>All Announcements</h2>
<% if (announcements.length === 0) { %>
  <p class="muted">No announcements yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr><th>Title</th><th>Message</th><th>Status</th><th>Date</th><th>Actions</th></tr>
    </thead>
    <tbody>
      <% announcements.forEach(function(a) { %>
        <tr>
          <td><%= a.title %></td>
          <td><%= a.body %></td>
          <td><span class="badge <%= a.active ? 'badge-active' : '' %>"><%= a.active ? 'Active' : 'Inactive' %></span></td>
          <td><%= new Date(a.created_at).toLocaleDateString() %></td>
          <td class="actions">
            <form action="/admin/announcements/<%= a.id %>/toggle" method="POST">
              <button type="submit" class="btn btn-small"><%= a.active ? 'Deactivate' : 'Activate' %></button>
            </form>
            <form action="/admin/announcements/<%= a.id %>/delete" method="POST" onsubmit="return confirm('Delete this announcement?');">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/admin-footer') %>
