<%- include('../partials/admin-header', { title: (product ? 'Edit' : 'Add') + ' Product - Admin' }) %>

<h1><%= product && product.id ? 'Edit Product' : 'Add Product' %></h1>

<% if (errors && errors.length) { %>
  <div class="alert alert-error">
    <ul>
      <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
    </ul>
  </div>
<% } %>

<form
  action="<%= product && product.id ? '/admin/products/' + product.id + '/edit' : '/admin/products/new' %>"
  method="POST"
  enctype="multipart/form-data"
  class="form"
>
  <label for="name">Product Name</label>
  <input type="text" id="name" name="name" value="<%= product ? product.name || '' : '' %>" required>

  <label for="category">Category / Part Type</label>
  <input type="text" id="category" name="category" value="<%= product ? product.category || '' : '' %>" placeholder="e.g. Brake Pads, Headlight, Filter">

  <label for="brand_id">Brand</label>
  <select id="brand_id" name="brand_id">
    <option value="">-- No specific brand --</option>
    <% brands.forEach(function(b) { %>
      <option value="<%= b.id %>" <%= product && String(product.brand_id) === String(b.id) ? 'selected' : '' %>><%= b.name %></option>
    <% }) %>
  </select>

  <label for="model_id">Model</label>
  <select id="model_id" name="model_id">
    <option value="">-- No specific model --</option>
    <% models.forEach(function(m) { %>
      <option value="<%= m.id %>" <%= product && String(product.model_id) === String(m.id) ? 'selected' : '' %>><%= m.name %></option>
    <% }) %>
  </select>

  <label for="price">Price (GHS)</label>
  <input type="number" id="price" name="price" step="0.01" min="0" value="<%= product ? product.price || '' : '' %>" required>

  <label for="stock">Stock Quantity</label>
  <input type="number" id="stock" name="stock" min="0" value="<%= product ? product.stock || 0 : 0 %>">

  <label for="description">Description</label>
  <textarea id="description" name="description" rows="4"><%= product ? product.description || '' : '' %></textarea>

  <label for="image">Product Image</label>
  <input type="file" id="image" name="image" accept="image/*">
  <% if (product && product.image) { %>
    <p class="muted">Current image:</p>
    <img src="<%= product.image %>" alt="Current image" class="thumb-preview">
  <% } %>

  <label class="checkbox-option">
    <input type="checkbox" name="featured" value="1" <%= product && product.featured ? 'checked' : '' %>>
    Show as Featured on Home Page
  </label>

  <button type="submit" class="btn"><%= product && product.id ? 'Save Changes' : 'Add Product' %></button>
</form>

<%- include('../partials/admin-footer') %>
