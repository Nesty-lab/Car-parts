<%- include('partials/header', { title: 'Order Confirmed - AutoParts Ghana' }) %>

<section class="container section narrow">
  <div class="alert alert-success">
    <h1>Order Confirmed!</h1>
    <p>Your order #<%= orderId %> for <strong><%= product.name %></strong> has been received.</p>
    <p>Payment method: <strong><%= paymentMethod %></strong></p>
    <% if (paymentMethod === 'Walk-in') { %>
      <p>Please visit your selected branch to complete payment and pick up your item.</p>
    <% } else { %>
      <p>Our team will contact you shortly to complete your online payment.</p>
    <% } %>
    <a href="/products" class="btn">Continue Shopping</a>
  </div>
</section>

<%- include('partials/footer') %>
