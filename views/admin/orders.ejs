<%- include('../partials/admin-header', { title: 'Orders - Admin' }) %>

<h1>Orders</h1>

<% if (orders.length === 0) { %>
  <p class="muted">No orders yet.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>#</th>
        <th>Date/Time</th>
        <th>Customer</th>
        <th>Contact</th>
        <th>Product</th>
        <th>Model</th>
        <th>Payment</th>
        <th>Branch/Region</th>
        <th>Status</th>
      </tr>
    </thead>
    <tbody>
      <% orders.forEach(function(o) { %>
        <tr>
          <td>#<%= o.id %></td>
          <td><%= new Date(o.created_at).toLocaleString() %></td>
          <td><%= o.customer_name %></td>
          <td><%= o.customer_phone %><% if (o.customer_email) { %><br><%= o.customer_email %><% } %></td>
          <td><%= o.product_name || '—' %></td>
          <td><%= o.model_name || '—' %></td>
          <td><%= o.payment_method %></td>
          <td><%= o.branch_name ? o.branch_name + ' (' + o.branch_region + ')' : '—' %></td>
          <td>
            <form action="/admin/orders/<%= o.id %>/status" method="POST" class="inline-form">
              <select name="status" onchange="this.form.submit()">
                <% ['Pending','Confirmed','Ready for Pickup','Completed','Cancelled'].forEach(function(s) { %>
                  <option value="<%= s %>" <%= o.status === s ? 'selected' : '' %>><%= s %></option>
                <% }) %>
              </select>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/admin-footer') %>
