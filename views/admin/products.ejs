<%- include('../partials/admin-header', { title: 'Products - Admin' }) %>

<div class="admin-page-header">
  <h1>Products</h1>
  <a href="/admin/products/new" class="btn">+ Add Product</a>
</div>

<% if (products.length === 0) { %>
  <p class="muted">No products yet. Click "Add Product" to create your first one.</p>
<% } else { %>
  <table class="admin-table">
    <thead>
      <tr>
        <th>Image</th>
        <th>Name</th>
        <th>Brand / Model</th>
        <th>Price</th>
        <th>Stock</th>
        <th>Featured</th>
        <th>Actions</th>
      </tr>
    </thead>
    <tbody>
      <% products.forEach(function(p) { %>
        <tr>
          <td>
            <% if (p.image) { %>
              <img src="<%= p.image %>" alt="<%= p.name %>" class="thumb">
            <% } else { %>
              <div class="thumb no-image">—</div>
            <% } %>
          </td>
          <td><%= p.name %></td>
          <td><%= p.brand_name || '—' %> <%= p.model_name ? '/ ' + p.model_name : '' %></td>
          <td>GHS <%= p.price.toFixed(2) %></td>
          <td><%= p.stock %></td>
          <td><%= p.featured ? 'Yes' : 'No' %></td>
          <td class="actions">
            <a href="/admin/products/<%= p.id %>/edit" class="btn btn-small">Edit</a>
            <form action="/admin/products/<%= p.id %>/delete" method="POST" onsubmit="return confirm('Delete this product?');">
              <button type="submit" class="btn btn-small btn-danger">Delete</button>
            </form>
          </td>
        </tr>
      <% }) %>
    </tbody>
  </table>
<% } %>

<%- include('../partials/admin-footer') %>
