<%- include('../partials/admin-header', { title: 'Brands & Models - Admin' }) %>

<h1>Brands &amp; Models</h1>
<p class="muted">Brands and models power the "Category Section" and filters on the user site.</p>

<div class="two-column">
  <div>
    <h2>Brands</h2>
    <form action="/admin/brands/new" method="POST" class="inline-form">
      <input type="text" name="name" placeholder="New brand name (e.g. BMW)" required>
      <button type="submit" class="btn btn-small">Add Brand</button>
    </form>

    <table class="admin-table">
      <thead>
        <tr><th>Brand</th><th>Models</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% brands.forEach(function(b) { %>
          <tr>
            <td><%= b.name %></td>
            <td><%= b.model_count %></td>
            <td>
              <form action="/admin/brands/<%= b.id %>/delete" method="POST" onsubmit="return confirm('Delete this brand and all its models?');">
                <button type="submit" class="btn btn-small btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>

  <div>
    <h2>Models</h2>
    <form action="/admin/models/new" method="POST" class="inline-form">
      <select name="brand_id" required>
        <option value="">-- Select Brand --</option>
        <% brands.forEach(function(b) { %>
          <option value="<%= b.id %>"><%= b.name %></option>
        <% }) %>
      </select>
      <input type="text" name="name" placeholder="New model name (e.g. X5)" required>
      <button type="submit" class="btn btn-small">Add Model</button>
    </form>

    <table class="admin-table">
      <thead>
        <tr><th>Model</th><th>Brand</th><th>Actions</th></tr>
      </thead>
      <tbody>
        <% models.forEach(function(m) { %>
          <tr>
            <td><%= m.name %></td>
            <td><%= m.brand_name %></td>
            <td>
              <form action="/admin/models/<%= m.id %>/delete" method="POST" onsubmit="return confirm('Delete this model?');">
                <button type="submit" class="btn btn-small btn-danger">Delete</button>
              </form>
            </td>
          </tr>
        <% }) %>
      </tbody>
    </table>
  </div>
</div>

<%- include('../partials/admin-footer') %>
