<%- include('partials/header', { title: product.name + ' - AutoParts Ghana' }) %>

<section class="container section product-detail">
  <div class="product-detail-image">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>">
    <% } else { %>
      <div class="no-image large">No Image</div>
    <% } %>
  </div>
  <div class="product-detail-info">
    <h1><%= product.name %></h1>
    <p class="muted"><%= product.brand_name || '' %> <%= product.model_name ? '- ' + product.model_name : '' %></p>
    <p class="price large">GHS <%= product.price.toFixed(2) %></p>
    <p class="stock <%= product.stock > 0 ? 'in-stock' : 'out-stock' %>">
      <%= product.stock > 0 ? 'In stock (' + product.stock + ' available)' : 'Out of stock' %>
    </p>
    <p class="description"><%= product.description || 'No description available for this product.' %></p>

    <% if (product.stock > 0) { %>
      <a href="/checkout/<%= product.id %>" class="btn">Buy Now</a>
    <% } else { %>
      <button class="btn" disabled>Out of Stock</button>
    <% } %>
  </div>
</section>

<%- include('partials/footer') %>
