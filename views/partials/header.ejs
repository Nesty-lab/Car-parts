<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'AutoParts Ghana - Car Spare Parts' %></title>
  <link rel="stylesheet" href="/css/style.css">
</head>
<body>
  <header class="site-header">
    <div class="container header-inner">
      <a href="/" class="logo">Auto<span>Parts</span></a>
      <nav class="main-nav">
        <a href="/" class="<%= page === 'home' ? 'active' : '' %>">Home</a>
        <a href="/about" class="<%= page === 'about' ? 'active' : '' %>">About</a>
        <a href="/products" class="<%= page === 'products' ? 'active' : '' %>">Products</a>
        <a href="/contact" class="<%= page === 'contact' ? 'active' : '' %>">Contact</a>
      </nav>
      <form action="/search" method="GET" class="header-search">
        <input type="text" name="q" placeholder="Search spare parts..." value="<%= typeof q !== 'undefined' ? q : '' %>">
        <button type="submit" aria-label="Search">&#128269;</button>
      </form>
    </div>
  </header>

  <% if (typeof announcements !== 'undefined' && announcements.length) { %>
    <div class="announcement-bar">
      <div class="container">
        <% announcements.forEach(function(a) { %>
          <span class="announcement-item"><strong><%= a.title %>:</strong> <%= a.body %></span>
        <% }) %>
      </div>
    </div>
  <% } %>

