<!DOCTYPE html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title><%= typeof title !== 'undefined' ? title : 'Admin - AutoParts Ghana' %></title>
  <link rel="stylesheet" href="/css/style.css">
  <link rel="stylesheet" href="/css/admin.css">
</head>
<body class="admin-body">
  <div class="admin-shell">
    <aside class="admin-sidebar">
      <a href="/admin" class="admin-logo">Auto<span>Parts</span> <small>Admin</small></a>
      <nav>
        <a href="/admin" class="<%= page === 'admin-dashboard' ? 'active' : '' %>">Dashboard</a>
