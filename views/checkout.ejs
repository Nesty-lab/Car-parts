<%- include('partials/header', { title: 'Checkout - AutoParts Ghana' }) %>

<section class="container section narrow">
  <h1>Checkout</h1>

  <div class="checkout-summary">
    <% if (product.image) { %>
      <img src="<%= product.image %>" alt="<%= product.name %>">
    <% } %>
    <div>
      <h3><%= product.name %></h3>
      <p class="price">GHS <%= product.price.toFixed(2) %></p>
    </div>
  </div>

  <% if (errors && errors.length) { %>
    <div class="alert alert-error">
      <ul>
        <% errors.forEach(function(e) { %><li><%= e %></li><% }) %>
      </ul>
    </div>
  <% } %>

  <form action="/checkout/<%= product.id %>" method="POST" class="form">
    <label for="customer_name">Full Name</label>
    <input type="text" id="customer_name" name="customer_name" required>

    <label for="customer_email">Email (optional)</label>
    <input type="email" id="customer_email" name="customer_email">

    <label for="customer_phone">Phone Number</label>
    <input type="tel" id="customer_phone" name="customer_phone" required>

    <fieldset class="payment-method">
      <legend>Payment Method</legend>
      <label class="radio-option">
        <input type="radio" name="payment_method" value="Online" required> Online Payment
      </label>
      <label class="radio-option">
        <input type="radio" name="payment_method" value="Walk-in" required> Walk-in Payment
      </label>
    </fieldset>

    <label for="branch_id">Select Branch / Region</label>
    <select id="branch_id" name="branch_id" required>
      <option value="">-- Choose a branch --</option>
      <% branches.forEach(function(b) { %>
        <option value="<%= b.id %>"><%= b.name %> (<%= b.region %>)</option>
      <% }) %>
    </select>

    <button type="submit" class="btn">Confirm Order</button>
  </form>
</section>

<%- include('partials/footer') %>
